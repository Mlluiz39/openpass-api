OPENPASS_ADDR=:8080
OPENPASS_DB_PATH=data/openpass.db
OPENPASS_DATABASE_URL=
OPENPASS_SECRET_FILE=data/openpass.secret
OPENPASS_ADMIN_PASSWORD=change-me

# Optional. If unset, OpenPass creates/uses OPENPASS_SECRET_FILE.
# Keep this stable; changing it prevents decrypting stored API keys and secrets.
OPENPASS_SECRET_KEY=

# Database: leave OPENPASS_DATABASE_URL empty for SQLite (default),
# or set a PostgreSQL connection string to use PostgreSQL instead.
# Examples:
#   OPENPASS_DATABASE_URL=postgres://user:pass@localhost:5432/openpass?sslmode=disable
