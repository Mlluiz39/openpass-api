OPENPASS_ADDR=:8080

# PostgreSQL connection string (server + migrations).
DATABASE_URL=postgres://openpass:openpass@localhost:5432/openpass?sslmode=disable

# Used by `go test ./...` to get an isolated schema per test.
# Defaults to DATABASE_URL-style local database when unset.
OPENPASS_TEST_DATABASE_URL=postgres://openpass:openpass@localhost:5432/openpass?sslmode=disable

OPENPASS_SECRET_FILE=data/openpass.secret

# E-mail of the first admin account. Used only when the users table is empty
# (empty database), so changing it later does not rename an existing account.
OPENPASS_ADMIN_EMAIL=admin@openpass.local
OPENPASS_ADMIN_PASSWORD=change-me

# Set to 1 to overwrite the saved panel password with OPENPASS_ADMIN_PASSWORD.
# Use it once if you forget the password, then unset it.
OPENPASS_ADMIN_PASSWORD_RESET=

# Optional. If unset, OpenPass creates/uses OPENPASS_SECRET_FILE.
# Keep this stable; changing it prevents decrypting stored API keys and secrets.
OPENPASS_SECRET_KEY=

# Docker Compose database credentials (used by docker-compose.yml).
POSTGRES_USER=openpass
POSTGRES_PASSWORD=openpass
POSTGRES_DB=openpass
